# ───────────────────────────────────────────────────────────────
#  Bandeja conversacional: environment variables
#  Copy to .env and fill in:   cp .env.example .env
#  .env is git-ignored. NEVER commit real values.
# ───────────────────────────────────────────────────────────────

# ── Telegram ───────────────────────────────────────────────────
# Bot token from @BotFather (/newbot). Format: 123456789:AA...
TELEGRAM_BOT_TOKEN=
# Shared secret Telegram sends in the X-Telegram-Bot-Api-Secret-Token header.
# 16-256 characters, only A-Z a-z 0-9 _ -   (e.g. generate with: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# ── ngrok ──────────────────────────────────────────────────────
# Authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional: your free static domain (https://dashboard.ngrok.com/domains), e.g. my-name.ngrok-free.app
# Leave empty to get a random URL (the webhook is re-registered automatically either way).
NGROK_DOMAIN=

# ── PostgreSQL (local container only) ──────────────────────────
POSTGRES_USER=inbox
POSTGRES_PASSWORD=change-me
POSTGRES_DB=inbox

# ── RabbitMQ (local container only) ────────────────────────────
RABBITMQ_USER=inbox
RABBITMQ_PASSWORD=change-me

# ── Frontend ───────────────────────────────────────────────────
# Host port for the inbox UI: http://localhost:4200
FRONTEND_PORT=4200
